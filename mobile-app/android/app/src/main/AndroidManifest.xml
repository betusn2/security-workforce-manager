<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

  <!-- ── Localisation ─────────────────────────────────────────────────────── -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!--
    ACCESS_BACKGROUND_LOCATION : Android 10+ (API 29+).
    DOIT être demandée séparément APRÈS ACCESS_FINE_LOCATION → jamais en même temps.
  -->
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

  <!-- ── Caméra ────────────────────────────────────────────────────────────── -->
  <uses-permission android:name="android.permission.CAMERA" />

  <!-- ── Services foreground (GPS continu) ───────────────────────────────── -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!--
    FOREGROUND_SERVICE_LOCATION : obligatoire sur Android 14 (API 34+)
    quand le foreground service accède à la localisation.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

  <!-- ── Réseau ────────────────────────────────────────────────────────────── -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- ── Notifications (Android 13+ / API 33+) ───────────────────────────── -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
    tools:targetApi="33" />

  <!-- ── Stockage ─────────────────────────────────────────────────────────── -->
  <!--
    READ_EXTERNAL_STORAGE : limité à API ≤ 32 (Android ≤ 12L).
    Android 13+ utilise READ_MEDIA_IMAGES à la place.
  -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32" />
  <!-- Sélection photo galerie — Android 13+ (API 33+) -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
    tools:targetApi="33" />
  <!--
    WRITE_EXTERNAL_STORAGE : obsolète API 29+ (Scoped Storage).
    Conservé uniquement pour Android ≤ 9 (API 28).
  -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />

  <!-- ── Divers ────────────────────────────────────────────────────────────── -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!--
    PERMISSIONS SUPPRIMÉES vs version précédente (raisons Play Protect) :
    - SYSTEM_ALERT_WINDOW  → haut risque Play Protect, inutile en production release
    - READ_PHONE_STATE     → non utilisé dans la logique métier
    - RECEIVE_BOOT_COMPLETED → non utilisé, signal négatif Play Protect
    - RECORD_AUDIO          → non utilisé dans la logique métier
  -->

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:networkSecurityConfig="@xml/network_security_config"
    android:requestLegacyExternalStorage="false"
    android:installLocation="auto"
    android:extractNativeLibs="false">

    <meta-data android:name="expo.modules.notifications.default_notification_color"
      android:resource="@color/notification_icon_color" />
    <meta-data android:name="expo.modules.notifications.default_notification_icon"
      android:resource="@drawable/notification_icon" />
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false" />
    <meta-data android:name="expo.modules.updates.EXPO_SDK_VERSION" android:value="50.0.0" />
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS" />
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0" />

    <activity
      android:name=".MainActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:theme="@style/Theme.App.SplashScreen"
      android:exported="true"
      android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="com.securityguard.mobile" />
      </intent-filter>
    </activity>

    <activity
      android:name="com.facebook.react.devsupport.DevSettingsActivity"
      android:exported="false" />

    <!--
      FOREGROUND SERVICE GPS — Android 14 (API 34)
      Obligatoire : foregroundServiceType="location"
      Déclaré android:exported="false" pour la sécurité (non accessible depuis l'extérieur)
    -->
    <service
      android:name="expo.modules.location.taskManager.BackgroundLocationService"
      android:foregroundServiceType="location"
      android:exported="false"
      android:stopWithTask="false" />

    <!--
      TaskService expo-task-manager — déclaré avec type location
      tools:replace pour écraser la déclaration du module expo
    -->
    <service
      android:name="expo.modules.taskManager.TaskService"
      android:foregroundServiceType="location"
      android:exported="false"
      android:stopWithTask="false"
      tools:replace="android:exported,android:foregroundServiceType" />

  </application>
</manifest>