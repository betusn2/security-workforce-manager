<?xml version="1.0" encoding="utf-8"?>
<!--
  Politique réseau Android 9+ (API 28+).
  - Cleartext (HTTP) interdit globalement.
  - Backend Render.com → HTTPS uniquement.
  - Aucun certificat de débogage autorisé en production.
-->
<network-security-config>

  <!-- ── Politique globale par défaut ──────────────────────────────────── -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <!-- Certificats système uniquement (pas de certificats utilisateur en prod) -->
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- ── Backend principal (Render.com) ───────────────────────────────── -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">security-guard-backend-w3qv.onrender.com</domain>
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </domain-config>

  <!-- ── Railway MySQL (connexions API uniquement via HTTPS) ───────────── -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">railway.app</domain>
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </domain-config>

</network-security-config>
