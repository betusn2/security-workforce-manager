{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview-local": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://security-workforce-manager.onrender.com/api"
      }
    },
    "apk-universal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local",
        "gradleCommand": ":app:assembleRelease",
        "withoutCredentials": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://security-workforce-manager.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://security-workforce-manager.onrender.com"
      }
    },
    "firebase": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://security-workforce-manager.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://security-workforce-manager.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "production-local": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local",
        "gradleCommand": ":app:bundleRelease"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "firebase": {
      "android": {
        "serviceAccountKeyPath": "./firebase-service-account.json",
        "firebaseAppId": "1:380656927574:android:dd8f0f6182a5b162560cf7",
        "groups": ["security-guards", "supervisors", "admins"],
        "releaseNotes": "Nouvelle version de Security Guard Mobile"
      }
    }
  }
}
