# Backend Environment Variables - Security Guard Management
# Copier ce fichier en .env et remplir les valeurs

# Server Configuration
PORT=5000
NODE_ENV=production

# ⚠️ MODE TEST - Désactiver validation fenêtres de temps (DÉVELOPPEMENT SEULEMENT)
# Mettre à 'true' pour bypasser les validations temporelles (check-in/check-out/tracking)
# ⚠️ NE JAMAIS ACTIVER EN PRODUCTION
BYPASS_TIME_WINDOWS=false

# Database Configuration (Railway MySQL)
# Valeurs disponibles dans le dashboard Railway → service MySQL → Variables
DB_HOST=your-railway-host.railway.app
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your-railway-db-password
DB_DIALECT=mysql
DB_SSL=false

# JWT Configuration — générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-min-64-chars
REFRESH_TOKEN_SECRET=change-this-to-another-long-random-secret

# CORS & WebSocket — URL du frontend Vercel après déploiement
FRONTEND_URL=https://security-workforce-manager.vercel.app
WEB_URL=https://security-workforce-manager.vercel.app
SOCKET_CORS_ORIGIN=https://security-workforce-manager.vercel.app

# Socket.IO Configuration
SOCKET_PATH=/socket.io/
SOCKET_TRANSPORTS=websocket,polling
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# File Upload
MAX_FILE_SIZE=10485760

# Session Configuration
SESSION_SECRET=change-this-session-secret

# Email Configuration (Optionnel - pour notifications par mail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

# Twilio SMS (Optionnel)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Facial Recognition - CompreFace (Optionnel)
COMPREFACE_API_URL=http://localhost:8000
COMPREFACE_API_KEY=your-compreface-api-key
