{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/sounds/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/sounds/$1"
    },
    {
      "src": "/favicon\\.ico",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/favicon.ico"
    },
    {
      "src": "/favicon-([0-9]+)\\.(png|svg)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/favicon-$1.$2"
    },
    {
      "src": "/favicon\\.svg",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/favicon.svg"
    },
    {
      "src": "/manifest\\.json",
      "headers": {
        "cache-control": "public, max-age=86400",
        "content-type": "application/manifest+json"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/asset-manifest\\.json",
      "dest": "/asset-manifest.json"
    },
    {
      "src": "/robots\\.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
