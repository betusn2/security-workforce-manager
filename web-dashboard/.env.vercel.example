# Frontend Environment Variables for Vercel
# Ces variables doivent être configurées dans le dashboard Vercel

# Backend API URL (sans /api à la fin pour l'URL de base, avec /api pour l'URL API)
REACT_APP_API_URL=https://your-backend.onrender.com/api

# Backend WebSocket URL (sans / à la fin)
REACT_APP_SOCKET_URL=https://your-backend.onrender.com

# Build Configuration
GENERATE_SOURCEMAP=false

# ⚠️ IMPORTANT:
# 1. Remplacez "your-backend.onrender.com" par votre vraie URL Render
# 2. Configurez ces variables dans Vercel Dashboard → Settings → Environment Variables
# 3. Les variables doivent être configurées pour: Production, Preview, et Development
